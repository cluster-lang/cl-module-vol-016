// cl-math-special-trans-stage-8632: Test Suite
import "../spcl_8632.zk"

fn test_run():
    res := special_approx_stage_8632(5.0, 2)
    diff := res - 177.7400
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
    test_run()
    print("✓ All tests passed for cl-math-special-trans-stage-8632!")
