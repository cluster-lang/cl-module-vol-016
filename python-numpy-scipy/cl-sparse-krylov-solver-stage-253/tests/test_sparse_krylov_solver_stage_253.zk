// cl-sparse-krylov-solver-stage-253: Test Suite
import "../sprs_253.zk"

fn test_run():
    res := sparse_krylov_step_253(0.5, 4.0, 2.0)
    diff := res - 5.5000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
    test_run()
    print("✓ All tests passed for cl-sparse-krylov-solver-stage-253!")
