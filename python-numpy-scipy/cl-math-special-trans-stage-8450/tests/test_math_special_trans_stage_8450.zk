// cl-math-special-trans-stage-8450: Test Suite
import "../spcl_8450.zk"

fn test_run():
    res := special_approx_stage_8450(5.0, 2)
    diff := res - 174.1000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
