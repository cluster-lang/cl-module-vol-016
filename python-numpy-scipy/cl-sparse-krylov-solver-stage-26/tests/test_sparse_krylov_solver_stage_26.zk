// cl-sparse-krylov-solver-stage-26: Test Suite
import "../sprs_26.zk"

fn test_run():
    res := sparse_krylov_step_26(0.5, 4.0, 2.0)
    diff := res - 4.1500
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
    test_run()
    print("✓ All tests passed for cl-sparse-krylov-solver-stage-26!")
