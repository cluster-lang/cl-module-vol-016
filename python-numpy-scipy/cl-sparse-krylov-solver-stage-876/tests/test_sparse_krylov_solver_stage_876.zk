// cl-sparse-krylov-solver-stage-876: Test Suite
import "../sprs_876.zk"

fn test_run():
    res := sparse_krylov_step_876(0.5, 4.0, 2.0)
    diff := res - 6.6500
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
    test_run()
    print("✓ All tests passed for cl-sparse-krylov-solver-stage-876!")
