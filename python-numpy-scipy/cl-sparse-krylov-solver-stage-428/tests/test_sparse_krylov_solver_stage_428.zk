// cl-sparse-krylov-solver-stage-428: Test Suite
import "../sprs_428.zk"

fn test_run():
    res := sparse_krylov_step_428(0.5, 4.0, 2.0)
    diff := res - 4.2500
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
    test_run()
    print("✓ All tests passed for cl-sparse-krylov-solver-stage-428!")
