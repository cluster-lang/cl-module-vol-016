// cl-math-special-trans-stage-9000: Test Suite
import "../spcl_9000.zk"

fn test_run():
    res := special_approx_stage_9000(5.0, 2)
    diff := res - 185.1000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
    test_run()
    print("✓ All tests passed for cl-math-special-trans-stage-9000!")
