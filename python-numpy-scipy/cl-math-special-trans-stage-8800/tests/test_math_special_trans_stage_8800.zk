// cl-math-special-trans-stage-8800: Test Suite
import "../spcl_8800.zk"

fn test_run():
    res := special_approx_stage_8800(5.0, 2)
    diff := res - 181.1000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
