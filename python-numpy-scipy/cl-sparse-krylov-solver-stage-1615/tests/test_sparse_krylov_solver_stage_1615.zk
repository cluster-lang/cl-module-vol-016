// cl-sparse-krylov-solver-stage-1615: Test Suite
import "../sprs_1615.zk"

fn test_run():
    res := sparse_krylov_step_1615(0.5, 4.0, 2.0)
    diff := res - 3.6000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
    test_run()
    print("✓ All tests passed for cl-sparse-krylov-solver-stage-1615!")
