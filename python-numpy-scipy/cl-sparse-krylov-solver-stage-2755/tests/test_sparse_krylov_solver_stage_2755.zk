// cl-sparse-krylov-solver-stage-2755: Test Suite
import "../sprs_2755.zk"

fn test_run():
    res := sparse_krylov_step_2755(0.5, 4.0, 2.0)
    diff := res - 5.6000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
    test_run()
    print("✓ All tests passed for cl-sparse-krylov-solver-stage-2755!")
