// cl-math-special-trans-stage-7400: Test Suite
import "../spcl_7400.zk"

fn test_run():
    res := special_approx_stage_7400(5.0, 2)
    diff := res - 153.1000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
