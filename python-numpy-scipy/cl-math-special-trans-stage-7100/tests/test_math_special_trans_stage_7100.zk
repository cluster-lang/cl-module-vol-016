// cl-math-special-trans-stage-7100: Test Suite
import "../spcl_7100.zk"

fn test_run():
    res := special_approx_stage_7100(5.0, 2)
    diff := res - 147.1000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
    test_run()
    print("✓ All tests passed for cl-math-special-trans-stage-7100!")
